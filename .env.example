# Shared access code for the reviewer screens at /review. At least 12 characters.
REVIEWER_ACCESS_CODE=

# Signs the reviewer cookie. Any long random string, for example the output of:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Model provider: "groq" (real model) or "fake" (scripted replies, no key needed).
MODEL_PROVIDER=groq

# Needed when MODEL_PROVIDER=groq. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b
# DATABASE_PATH=data/app.db
# HOST=127.0.0.1
# PORT=8000
